# 接收 Webhook 的簽名驗證 secret（在 Latenode 平台上設定後填入）
LATENODE_WEBHOOK_SECRET=your_secret_here

# 主動觸發 Latenode workflow 的 URL（從 Latenode 節點的 HTTP trigger 取得）
LATENODE_API_URL=https://webhook.latenode.com/v1/...
# API Key（若 Latenode workflow 需要驗證）
LATENODE_API_KEY=

# 收到 webhook 後回呼另一個 Latenode workflow（選填）
LATENODE_CALLBACK_URL=

# 伺服器設定
PORT=8000
HOST=0.0.0.0
